{
  "manifest_version": 3,
  "name": "선물노트 스레드 수집기",
  "version": "0.4.0",
  "description": "스레드 게시물 옆에서 좋아요·조회수를 보고 직접 고른 글을 로컬에 저장합니다.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "content_scripts": [{
    "matches": ["https://www.threads.com/*", "https://threads.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "스레드 글 수집",
    "default_popup": "popup.html"
  }
}
